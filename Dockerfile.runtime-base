# 允许调用方替换 Ubuntu runtime 基础镜像；默认使用 Ubuntu 22.04。
ARG UBUNTU_IMAGE=ubuntu:22.04

# 使用 Ubuntu 22.04 构建包含 JDK、Node.js 和 PostgreSQL 的 runtime 基础层。
FROM ${UBUNTU_IMAGE} AS runtime-base

# 切换到 root，确保可以安装 deb 包、解压本地运行时和创建系统用户。
USER root

# 关闭安装过程中的交互提示，并统一容器时区，保证构建过程可自动执行。
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC

# 指定本地 JDK 归档路径；构建时直接 COPY，不在 Docker build 中联网下载 JDK。
ARG LOCAL_JDK_ARCHIVE=docker/runtime/jdk-21_linux-x64_bin.tar.gz

# 指定本地 Node.js 归档路径；构建时直接 COPY，不在 Docker build 中联网下载 Node.js。
ARG LOCAL_NODE_ARCHIVE=docker/runtime/node-v22-linux-x64.tar.gz

# 指定本地 PostgreSQL Debian 依赖归档；构建时直接 COPY 后离线安装 PostgreSQL。
ARG LOCAL_POSTGRES_DEB_ARCHIVE=docker/runtime/postgresql-16-ubuntu22.04-x64-debs.tar.gz

# 设置 Java 安装目录，供 Java 启动脚本和后端运行时使用。
# 设置 Node.js 安装目录，供前端构建工具或容器内脚本使用。
# 固定 PostgreSQL 主版本，供 PATH 和入口脚本定位 PostgreSQL 二进制。
# 固定 PostgreSQL 数据目录，供 PostgreSQL 初始化和运行时使用。
# 将 Java、Node.js 和 PostgreSQL 的可执行目录加入 PATH。
ENV JAVA_HOME=/opt/java/openjdk \
    NODE_HOME=/opt/nodejs \
    PG_MAJOR=16 \
    PGDATA=/var/lib/postgresql/data \
    PATH=/opt/java/openjdk/bin:/opt/nodejs/bin:/usr/lib/postgresql/16/bin:${PATH}

# 将本地 JDK 归档复制到镜像临时目录，后续解压到 JAVA_HOME。
COPY ${LOCAL_JDK_ARCHIVE} /tmp/local-jdk.tar.gz

# 将本地 Node.js 归档复制到镜像临时目录，后续解压到 NODE_HOME。
COPY ${LOCAL_NODE_ARCHIVE} /tmp/local-node.tar.gz

# 将本地 PostgreSQL Debian 包归档复制到镜像临时目录，后续离线安装。
COPY ${LOCAL_POSTGRES_DEB_ARCHIVE} /tmp/local-postgres-debs.tar.gz

# 创建 JDK、Node.js、PostgreSQL 临时包和运行时数据目录。
# 解压 JDK 到 JAVA_HOME，并去掉归档自身的顶层目录。
# 解压 Node.js 到 NODE_HOME，并去掉归档自身的顶层目录。
# 解压 PostgreSQL Debian 包到待安装目录。
# 使用 dpkg 离线安装 PostgreSQL 及其本地依赖包。
# 删除所有安装归档和临时解压目录，减少最终基础镜像体积。
# 如果 postgres 用户组不存在则创建系统组。
# 如果 postgres 用户不存在则创建系统用户并指定其 home 目录和 shell。
# 将 DocLens、PostgreSQL 和 PostgreSQL 运行时目录交给 postgres 用户。
RUN mkdir -p "${JAVA_HOME}" "${NODE_HOME}" /tmp/postgres-debs /var/lib/postgresql/data /var/lib/doclens/storage /var/run/postgresql \
    && tar -xzf /tmp/local-jdk.tar.gz --strip-components=1 -C "${JAVA_HOME}" \
    && tar -xzf /tmp/local-node.tar.gz --strip-components=1 -C "${NODE_HOME}" \
    && tar -xzf /tmp/local-postgres-debs.tar.gz -C /tmp/postgres-debs \
    && DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC dpkg -i /tmp/postgres-debs/*.deb \
    && rm -rf /tmp/local-jdk.tar.gz /tmp/local-node.tar.gz /tmp/local-postgres-debs.tar.gz /tmp/postgres-debs \
    && (getent group postgres >/dev/null || groupadd -r postgres) \
    && (id -u postgres >/dev/null 2>&1 || useradd -r -g postgres -d /var/lib/postgresql -s /bin/bash postgres) \
    && chown -R postgres:postgres /var/lib/doclens /var/lib/postgresql /var/run/postgresql
