DOCLENS_IMAGE_REPOSITORY=doclens
DOCLENS_IMAGE_TAG=amd64
DOCLENS_CONTAINER_NAME=doclens-all-in-one

SPRING_PROFILES_ACTIVE=prod
DOCLENS_SERVER_PORT=10003
POSTGRES_PORT=5432
POSTGRES_DB=doclens
POSTGRES_USER=doclens
POSTGRES_PASSWORD=replace-with-strong-password

DOCLENS_DB_URL=
DOCLENS_DB_USERNAME=
DOCLENS_DB_PASSWORD=
DOCLENS_DB_DRIVER=org.postgresql.Driver

DOCLENS_STORAGE_ROOT=/var/lib/doclens/storage
DOCLENS_WORKER_ID=doclens-worker-1

DOCLENS_PADDLE_OCR_ENDPOINT=http://paddle-ocr:8080/ocr
DOCLENS_PADDLE_OCR_NODE_NAME=paddle-primary
DOCLENS_PADDLE_OCR_NODE_HOST=paddle-ocr
DOCLENS_PADDLE_OCR_NODE_PORT=8080
DOCLENS_WORD_CONVERSION_COMMAND=/usr/bin/soffice

DOCLENS_GATEWAY_SECRET=replace-with-gateway-secret
DOCLENS_GATEWAY_PRINCIPAL=dashboard-admin
DOCLENS_GATEWAY_PARTITION=default
