SPRING_PROFILES_ACTIVE=prod
DOCLENS_SERVER_PORT=10003
POSTGRES_PORT=5432
DOCLENS_DB_URL=jdbc:postgresql://localhost:${POSTGRES_PORT:-5432}/doclens
DOCLENS_DB_USERNAME=doclens
DOCLENS_DB_PASSWORD=
DOCLENS_DB_DRIVER=org.postgresql.Driver
DOCLENS_CONFIG_DIR=/opt/doclens/config
SPRING_CONFIG_ADDITIONAL_LOCATION=optional:file:/opt/doclens/conf/,optional:file:${DOCLENS_CONFIG_DIR:-/opt/doclens/config}/
DOCLENS_STORAGE_ROOT=/var/lib/doclens/storage
DOCLENS_WORKER_ID=doclens-worker-1
DOCLENS_PADDLE_OCR_ENDPOINT=
DOCLENS_WORD_CONVERSION_COMMAND=/usr/bin/soffice
DOCLENS_GATEWAY_SECRET=
DOCLENS_GATEWAY_PRINCIPAL=dashboard-admin
DOCLENS_GATEWAY_PARTITION=default
