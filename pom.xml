<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>io.github.lvdaxianer</groupId>
    <artifactId>doclens-j</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>DocLens Java</name>
    <description>DocLens OCR SDK and HTTP service implemented with DDD boundaries</description>

    <modules>
        <module>doclens-api</module>
        <module>doclens-core</module>
        <module>doclens-spring-boot-starter</module>
        <module>doclens-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>ban-sdk-web-dependencies</id>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <bannedDependencies>
                                        <searchTransitive>true</searchTransitive>
                                        <excludes>
                                            <exclude>org.springframework.boot:spring-boot-starter-web</exclude>
                                            <exclude>org.springframework.boot:spring-boot-starter-tomcat</exclude>
                                            <exclude>org.springframework:spring-web</exclude>
                                            <exclude>org.springframework:spring-webmvc</exclude>
                                        </excludes>
                                    </bannedDependencies>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
